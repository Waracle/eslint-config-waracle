{
  "name": "eslint-config-waracle",
  "version": "1.2.0",
  "description": "Waraclised version of the Airbnb eslint ruleset",
  "keywords": [
    "eslint",
    "lint",
    "rules",
    "sonarcloud",
    "typescript",
    "waracle"
  ],
  "homepage": "https://github.com/Waracle/eslint-config-waracle#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:Waracle/eslint-config-waracle.git"
  },
  "license": "MIT",
  "author": "Waracle Ltd. <support@waracle.com>",
  "contributors": [
    {
      "name": "Dan Overton",
      "email": "d.overton@waracle.com"
    },
    {
      "name": "Daniel Waghorn",
      "email": "d.waghorn@waracle.com"
    },
    {
      "name": "Nick Hammond",
      "email": "n.hammond@waracle.com"
    },
    {
      "name": "Sam Wall",
      "email": "sam.wall@waracle.com"
    }
  ],
  "main": "base.js",
  "scripts": {
