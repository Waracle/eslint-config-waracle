    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "prettier": "3.8.3",
    "prettier-plugin-packagejson": "^3.0.0",
    "semantic-release": "25.0.8"
